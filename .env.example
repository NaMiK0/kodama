# Шаблон переменных окружения. Скопируй в .env и подставь свои значения:
#   cp .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore) — там реальные секреты.

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=kodama
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kodama
POSTGRES_HOST=localhost
# Порт на хосте. Смени, если 5432 уже занят другим Postgres.
POSTGRES_PORT=5433
