# Шаблон переменных окружения. Скопируй в .env и подставь свои значения:
#   cp .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore) — там реальные секреты.

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=kodama
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kodama
POSTGRES_HOST=localhost
# Порт на хосте. Смени, если 5432 уже занят другим Postgres.
POSTGRES_PORT=5433

# ── JWT ──
# Сгенерируй свой секрет: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_generate_a_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── LLM / OpenRouter ──
OPENROUTER_API_KEY=change_me_your_openrouter_key
LLM_MODEL=inclusionai/ling-3.0-flash:free

# ── RabbitMQ ──
RABBITMQ_USER=kodama
RABBITMQ_PASSWORD=change_me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# ── Redis ──
REDIS_HOST=localhost
# Порт на хосте. Смени, если 6379 уже занят другим Redis.
REDIS_PORT=6380
