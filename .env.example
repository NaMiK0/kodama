# Шаблон переменных окружения. Скопируй в .env и подставь свои значения:
#   cp .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore) — там реальные секреты.

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=kodama
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kodama
POSTGRES_HOST=localhost
# Порт на хосте. Смени, если 5432 уже занят другим Postgres.
POSTGRES_PORT=5433

# ── JWT ──
# Сгенерируй свой секрет: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_generate_a_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── LLM / OpenRouter ──
OPENROUTER_API_KEY=change_me_your_openrouter_key
LLM_MODEL=inclusionai/ling-3.0-flash:free

# ── RabbitMQ ──
RABBITMQ_USER=kodama
RABBITMQ_PASSWORD=change_me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# ── Redis ──
REDIS_HOST=localhost
# Порт на хосте. Смени, если 6379 уже занят другим Redis.
REDIS_PORT=6380

# ── SMTP (email) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change_me@gmail.com
SMTP_PASSWORD=change_me_gmail_app_password
# console — печатать письма в лог (разработка), smtp — реальная отправка
EMAIL_BACKEND=console

# ── Google OAuth ──
# Создать: console.cloud.google.com -> Clients -> Create OAuth client ID (Web application)
GOOGLE_CLIENT_ID=change_me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change_me
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Проверка произношения ──
# stub — заглушка без ML (быстрая отладка пайплайна), real — настоящие модели
PRONUNCIATION_BACKEND=stub
# tiny | base | small | medium — больше = точнее и медленнее
WHISPER_MODEL=small
# Временная папка для загруженного аудио (файлы удаляются после обработки)
UPLOAD_DIR=uploads
