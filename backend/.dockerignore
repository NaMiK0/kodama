# Виртуальное окружение пересоздаётся внутри образа
.venv/

# Кеши и мусор
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Временные аудиофайлы (в образе им не место — для них volume)
uploads/

# Секреты не должны попадать в образ (пробрасываются через env_file)
.env
.env.local

.git/
.DS_Store
